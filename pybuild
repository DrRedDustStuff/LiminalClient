# Important info
Macro( "name", "Liminal Client" )
Name( "![name]" )

# Build info
ScriptPath( "./main.py" )
IsGui( True )
SaveAsOne( False )
IconFile( "./resources/image/icon.ico" )

# Zip instructions
NewFolder( "./![name]" )

CopyFolder( "./resources/", "./![name]/resources/" )
CopyFolder( "./plugins/", "./![name]/plugins/" )
CopyFile( "./dist/![name]/![name].exe", "./![name]/![name].exe" )
CopyFolder( "./dist/![name]/_internal/", "./![name]/_internal/" )

CopyFolder( "./![name]/", "./zipped/latest/" )
Archive( "![name]", "./![name]" )

MoveFile( "./![name].zip", "./zipped/![name].zip" )
