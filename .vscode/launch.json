    "version": "0.2.0",
    "configurations": [
        {
            "name": "Build and Zip",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/PYBuilder/Build_Zip.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Main",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/terminal-eml/main.py",
            "console": "externalTerminal",
            "cwd": "${workspaceFolder}/src/terminal-eml/"
        }
    ]
}